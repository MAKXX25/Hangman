# ── Frontend (Vercel) Environment Variables ──────────────────────────────
# Point your Next.js frontend on Vercel to your deployed Render.com / Railway backend URL:
# (In local dev, defaults to http://localhost:3001 if omitted)
NEXT_PUBLIC_BACKEND_URL=https://hangman-backend.onrender.com

# ── Backend (Render / Railway) Environment Variables ──────────────────────
# Comma-separated list of allowed frontend origins for CORS:
ALLOWED_ORIGINS=https://your-hangman-app.vercel.app,http://localhost:3000
PORT=3001
NODE_ENV=production
