# ── Pusher Environment Variables ─────────────────────────────────────────────
# Create a free account at https://pusher.com, create an app, then copy the
# credentials from the "App Keys" tab into your Vercel dashboard and .env.local.
#
# SERVER-SIDE (never exposed to the browser):
PUSHER_APP_ID=your_app_id
PUSHER_KEY=your_key
PUSHER_SECRET=your_secret
PUSHER_CLUSTER=mt1

# CLIENT-SIDE (safe to expose, needed by pusher-js in the browser):
NEXT_PUBLIC_PUSHER_KEY=your_key
NEXT_PUBLIC_PUSHER_CLUSTER=mt1

# ── Legacy variables (no longer required after the Pusher migration) ──────────
# NEXT_PUBLIC_BACKEND_URL was used to point at the Socket.io/Render backend.
# ALLOWED_ORIGINS was for the Render CORS config.
# Both are safe to delete from your Vercel dashboard.
# NEXT_PUBLIC_BACKEND_URL=https://your-backend.onrender.com
# ALLOWED_ORIGINS=https://your-app.vercel.app
# PORT=3001
# NODE_ENV=production
